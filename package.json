{
  "name": "niso",
  "version": "11.0.0",
  "private": true,
  "scripts": {
    "build:frontend": "cd frontend && npm run build",
    "predeploy": "npm run build:frontend",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "cf-typegen": "wrangler types",
    "openapi": "node scripts/gerar-openapi.mjs && node scripts/gerar-contrato-mcp.mjs",
    "skills:gerar": "node scripts/gerar-skills.mjs",
    "db:backup": "wrangler d1 export niso-db --remote --output backups/niso-backup.sql",
    "db:backup:local": "wrangler d1 export niso-db --local --output backups/local-backup.sql"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.28.1",
    "docx": "^9.10.0",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^4.1.12",
    "typescript": "^5.5.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.150.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "undici": "^7.30.1",
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "vite": "^8.3.4",
    "ip-address": "^10.7.4",
    "body-parser": "^2.4.0",
    "fast-uri": "^3.1.9",
    "zod": "^4.6.7"
  }
}
